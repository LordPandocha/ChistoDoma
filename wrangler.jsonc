{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "chistodoma",
  "main": "telegram-worker/index.js",
  "compatibility_date": "2026-10-03",
  "routes": [
    {
      "pattern": "api.chistodoma86.ru",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_CHAT_ID",
      "YANDEX_SMARTCAPTCHA_SERVER_KEY"
    ]
  }
}
